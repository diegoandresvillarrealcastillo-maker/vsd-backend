{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.ts",
    "vitest.config.mts",
    "vitest.integracion.config.mts",
    "prisma.config.ts",
    "scripts/carga/*.ts",
    "scripts/carga/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
