# ============================================================
#  vsd-backend - variables de entorno (PLANTILLA)
# ============================================================
#
#  Copiar este archivo como .env y rellenar los valores.
#  .env esta ignorado por Git y nunca debe versionarse.
#
#  Ninguno de estos valores puede pasar al frontend.
# ============================================================

# ---------- Base de datos ----------
#
# En DESARROLLO se usa el PostgreSQL local de docker-compose.yml:
#
#   DATABASE_URL=postgresql://vsd:vsd_local@localhost:5432/vsd_health?schema=public
#   DIRECT_URL=postgresql://vsd:vsd_local@localhost:5432/vsd_health?schema=public
#
# Esas credenciales son locales y triviales a proposito: la base no sale de
# tu maquina y no contiene informacion de ninguna persona real.
#
# En PRE y PROD se usan los valores de Supabase, que estan en
# Project Settings > Database > Connection string. Nunca se escriben aqui.

# Conexion de la aplicacion, a traves del pooler de conexiones.
# Puerto 6543 y pgbouncer=true. Render abre y cierra conexiones con
# frecuencia, y sin el pooler se agota el limite del plan gratuito.
#
# El usuario de esta URL debe ser "vsd_app", NO el dueno de las tablas.
# El dueno esta exento de las politicas de aislamiento, asi que conectarse
# con el desactiva el Row Level Security sin dar ningun error. Fuera de
# desarrollo, la aplicacion lo detecta al arrancar y se niega a arrancar.
#
# La migracion crea "vsd_app" sin contrasena. Una sola vez por ambiente:
#   ALTER ROLE vsd_app WITH LOGIN PASSWORD 'la del gestor de contrasenas';
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Conexion directa, puerto 5432, sin pooler.
# La usa exclusivamente "prisma migrate": las migraciones necesitan
# sentencias que el pooler en modo transaccion no admite.
DIRECT_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

# ---------- Autenticacion (Supabase Auth) ----------

# URL del proyecto de Supabase. Es obligatoria en los cuatro ambientes,
# incluido desarrollo: sin ella la API no puede comprobar quien llama y se
# niega a arrancar.
#
# De aqui salen dos cosas:
#   - el emisor que se exige en cada token: <URL>/auth/v1
#   - la lista de claves publicas: <URL>/auth/v1/.well-known/jwks.json
#
# No es un secreto. Es la direccion publica del proyecto, la misma que ya
# conoce el navegador de cualquiera que use la aplicacion.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# NO hace falta SUPABASE_JWT_SECRET, y es deliberado.
#
# Ese secreto sirve para firmar, no solo para comprobar. Tenerlo aqui
# significaria que filtrar la configuracion del servidor basta para fabricar
# la identidad de cualquier persona. La API verifica contra la clave publica
# del JWKS: quien la consiga solo puede hacer lo que ya podia, comprobar.
#
# Si lo tienes en tu .env de antes, borralo.

# ---------- Servidor ----------

# Puerto de escucha de la API.
PORT=3000

# Entorno: development | preproduction | production
NODE_ENV=development

# Origenes autorizados para CORS, separados por coma.
# En produccion debe ser el dominio exacto de la PWA, nunca "*".
CORS_ORIGIN=http://localhost:5173
