// Esquema de datos de VSD Health.
//
// La fuente de verdad es docs/modelo-de-datos.md. Si este archivo y aquel
// documento discrepan, se corrige este archivo.
//
// Los nombres de las tablas y columnas van en espanol y en snake_case, como
// el diccionario de datos; los del cliente de Prisma en camelCase, como el
// resto del codigo. `@map` y `@@map` hacen de puente entre los dos mundos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Desde Prisma 7 las URL de conexion no viven aqui. Las de migracion estan en
// prisma.config.ts y la de la aplicacion la recibe el cliente a traves de un
// adaptador. Ver ADR 0010.

/// Rol de la cuenta. El administrador gestiona contenidos, no personas.
enum Rol {
  usuario
  administrador

  @@map("rol")
}

/// Como se interpreta el puntaje de una actividad.
///
/// Sin esto, un puntaje alto en un cuestionario de carga se leeria como
/// favorable, y el sistema le diria que va bien a quien peor esta.
enum DireccionEscala {
  mayor_es_mejor
  mayor_requiere_atencion
  sin_puntaje

  @@map("direccion_escala")
}

enum FrecuenciaActividad {
  diaria
  semanal
  unica

  @@map("frecuencia_actividad")
}

/// Nivel orientativo. Descriptivo, nunca clinico: VSD Health no diagnostica.
enum NivelOrientativo {
  favorable
  en_seguimiento
  requiere_atencion

  @@map("nivel_orientativo")
}

/// Formato del contenido de una entrada de diario.
///
/// Sin conexion solo hay texto plano: es lo que permite escribir en cualquier
/// momento y lo que hace viable reconciliar la sincronizacion despues.
enum FormatoEntrada {
  texto_plano
  enriquecido

  @@map("formato_entrada")
}

/// El color de un pendiente del semaforo (SCRUM-97).
enum NivelPendiente {
  urgente
  prioridad
  aplazable

  @@map("nivel_pendiente")
}

/// Un pendiente del semaforo (SCRUM-97). Datos personales: aislado por
/// persona con RLS forzado, igual que RESULTADO, y se borra con la cuenta.
model Pendiente {
  id        String         @id @default(uuid()) @map("id_pendiente") @db.Uuid
  idUsuario String         @map("id_usuario") @db.Uuid
  texto     String         @db.VarChar(280)
  nivel     NivelPendiente
  hecho     Boolean        @default(false)

  /// Mientras no llegue, el pendiente no recuerda nada.
  posponerHasta DateTime? @map("posponer_hasta") @db.Timestamptz(3)

  /// Dia limite, en el calendario de la persona (SCRUM-119). Es un dia y no un
  /// instante: "el 12" es el 12 donde ella esta. Sin el, no vence un dia
  /// concreto.
  fechaLimite DateTime? @map("fecha_limite") @db.Date

  idOperacionCliente String @map("id_operacion_cliente") @db.Uuid

  /// Sube en uno con cada edicion (SCRUM-134). La API compara la que trae el
  /// dispositivo con esta, dentro del propio UPDATE, para no pisar lo que otro
  /// dispositivo cambio mientras uno estaba sin conexion.
  version Int @default(1)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  fechaEdicion  DateTime @updatedAt @map("fecha_edicion") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([idUsuario, idOperacionCliente])
  @@index([idUsuario, hecho])
  @@map("pendiente")
}

model Usuario {
  id                      String   @id @default(uuid()) @map("id_usuario") @db.Uuid
  nombre                  String?  @db.VarChar(100)
  correo                  String   @unique @db.VarChar(120)
  idProveedorAuth         String   @unique @map("id_proveedor_auth") @db.VarChar(255)
  rol                     Rol      @default(usuario)
  /// Version de la politica que acepto. Las politicas cambian, y hay que poder
  /// demostrar a que dio permiso cada quien. Ley 1581 de 2012.
  versionPoliticaAceptada String   @map("version_politica_aceptada") @db.VarChar(20)
  fechaAceptacionPolitica DateTime @map("fecha_aceptacion_politica") @db.Timestamptz(3)
  fechaRegistro           DateTime @default(now()) @map("fecha_registro") @db.Timestamptz(3)
  /// Claves estables: cognicion, bienestar, emociones. Vacia mientras la
  /// persona no ha elegido con cuales empezar. SCRUM-88.
  modulosActivos          String[] @default([]) @map("modulos_activos")
  /// Personaje (forma) y nombre; color y accesorio, opcionales. Sin valor se usa la mascota de siempre.
  mascota                 Json?    @db.JsonB
  /// Si permite que el diario se lea para recomendarle. Apagado por defecto (SCRUM-108).
  diarioConRecomendaciones Boolean @default(false) @map("diario_con_recomendaciones")
  /// Zona IANA de la persona, informada por su dispositivo (SCRUM-123). Decide
  /// que dia es para ella. Las cuentas anteriores quedan en America/Bogota.
  zonaHoraria String @default("America/Bogota") @map("zona_horaria") @db.VarChar(64)
  /// Cuando se guardo la foto de perfil (SCRUM-120). NULL si no tiene. La foto en
  /// si vive en Supabase Storage, no en la base.
  fotoActualizadaEl DateTime? @map("foto_actualizada_el") @db.Timestamptz(3)
  /// Cuando se guardo la mascota propia, un SVG (SCRUM-122). NULL si no tiene. El
  /// archivo vive en Supabase Storage, no en la base.
  mascotaPropiaActualizadaEl DateTime? @map("mascota_propia_actualizada_el") @db.Timestamptz(3)

  resultados       Resultado[]
  entradasDeDiario EntradaDiario[]
  pendientes       Pendiente[]
  suscripcionesPush SuscripcionPush[]
  preferenciaAviso PreferenciaAviso?

  @@map("usuario")
}

/// Un navegador donde la persona acepto los avisos (SCRUM-102).
model SuscripcionPush {
  id            String   @id @default(uuid()) @map("id_suscripcion") @db.Uuid
  idUsuario     String   @map("id_usuario") @db.Uuid
  /// Unica en toda la tabla: un navegador entrega los avisos de una sola persona.
  endpoint      String   @unique
  claveP256dh   String   @map("clave_p256dh")
  claveAuth     String   @map("clave_auth")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario])
  @@map("suscripcion_push")
}

/// A que hora quiere cada aviso, en minutos desde la medianoche de Colombia (SCRUM-102).
model PreferenciaAviso {
  idUsuario           String    @id @map("id_usuario") @db.Uuid
  /// Null es apagado.
  minutoSemaforo      Int?      @map("minuto_semaforo") @db.SmallInt
  minutoRacha         Int?      @map("minuto_racha") @db.SmallInt
  /// Los recordatorios de las 8:00 y las 20:00 (SCRUM-126). La hora no se
  /// mueve: la aplicacion solo escribe 480 y 1200, o null para apagarlos.
  minutoManana        Int?      @map("minuto_manana") @db.SmallInt
  minutoNoche         Int?      @map("minuto_noche") @db.SmallInt
  /// El ultimo dia, en la zona de la persona, en que se reviso cada aviso.
  ultimoAvisoSemaforo DateTime? @map("ultimo_aviso_semaforo") @db.Date
  ultimoAvisoRacha    DateTime? @map("ultimo_aviso_racha") @db.Date
  ultimoAvisoManana   DateTime? @map("ultimo_aviso_manana") @db.Date
  ultimoAvisoNoche    DateTime? @map("ultimo_aviso_noche") @db.Date
  /// La zona en que se leen los minutos de arriba. La copia la base desde
  /// `usuario.zona_horaria` (disparadores de la migracion de SCRUM-123): la
  /// tarea de avisos solo puede leer esta tabla y necesita saber en que zona
  /// es cada hora. Nadie la escribe desde la aplicacion.
  zonaHoraria         String    @default("America/Bogota") @map("zona_horaria") @db.VarChar(64)
  fechaEdicion        DateTime  @default(now()) @updatedAt @map("fecha_edicion") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([minutoSemaforo])
  @@index([minutoRacha])
  @@index([minutoManana])
  @@index([minutoNoche])
  @@map("preferencia_aviso")
}

model Categoria {
  id          String  @id @default(uuid()) @map("id_categoria") @db.Uuid
  nombre      String  @unique @db.VarChar(50)
  descripcion String?
  /// El modulo al que corresponde: cognicion, bienestar o emociones. Es la
  /// clave estable; el nombre es texto visible y puede cambiar. SCRUM-91.
  modulo      String? @unique @db.VarChar(20)

  actividades     Actividad[]
  recursosDeApoyo RecursoApoyo[]

  @@map("categoria")
}

model Actividad {
  id          String  @id @default(uuid()) @map("id_actividad") @db.Uuid
  idCategoria String  @map("id_categoria") @db.Uuid
  nombre      String  @db.VarChar(100)
  tipo        String  @db.VarChar(30)
  descripcion String?
  estado      Boolean @default(true)

  /// Hacia donde va la escala de esta actividad.
  direccionEscala DireccionEscala @map("direccion_escala")
  /// Maximo posible. Vacio cuando la actividad no puntua.
  puntajeMaximo   Decimal?        @map("puntaje_maximo") @db.Decimal(5, 2)
  /// Cortes de nivel propios de esta actividad. Partir en tercios es
  /// arbitrario: una bitacora de sueno no quiebra donde un juego de atencion.
  umbrales        Json?
  /// Textos que ve la persona, en el lenguaje de esta actividad.
  textosNivel     Json?           @map("textos_nivel")

  /// Cada cuanto toca: diaria, ciertos dias de la semana o una sola vez.
  frecuencia  FrecuenciaActividad @default(diaria)
  /// Para las semanales: 1 es lunes y 7 domingo.
  diasSemana  Int[]               @default([]) @map("dias_semana") @db.SmallInt
  /// Desde que sesion del modulo aparece. SCRUM-91.
  desdeSesion Int                 @default(1) @map("desde_sesion")

  categoria  Categoria   @relation(fields: [idCategoria], references: [id], onDelete: Restrict)
  resultados Resultado[]

  @@index([idCategoria])
  @@map("actividad")
}

model Resultado {
  id          String @id @default(uuid()) @map("id_resultado") @db.Uuid
  idUsuario   String @map("id_usuario") @db.Uuid
  idActividad String @map("id_actividad") @db.Uuid

  /// Normalizado de 0 a 100 para poder comparar actividades de escalas
  /// distintas, que es lo que pide el RF7. El valor crudo queda en `metadata`.
  ///
  /// **No sale por la API.** Vive aqui para calcular tendencias; lo que ve la
  /// persona es el nivel.
  puntaje          Decimal?          @db.Decimal(5, 2)
  nivelOrientativo NivelOrientativo? @map("nivel_orientativo")

  /// Informacion propia del tipo de actividad. Ver ADR 0008.
  metadata Json?

  /// Lo genera el dispositivo al terminar la actividad, incluso sin conexion.
  ///
  /// La restriccion UNIQUE es lo que convierte la idempotencia de una regla de
  /// la aplicacion en una garantia de la base: aunque el codigo falle, el
  /// duplicado no entra.
  ///
  /// Es unico **por persona**, no en toda la tabla. Ver ADR 0010: con un
  /// unico global, mandar el identificador de otra persona daba una respuesta
  /// distinta a mandar uno inexistente, y esa diferencia sola ya permite
  /// averiguar que operaciones ajenas existen.
  idOperacionCliente String @map("id_operacion_cliente") @db.Uuid

  fecha DateTime @default(now()) @db.Timestamptz(3)

  /// El dia, en la zona de la persona, en que se completo (SCRUM-123). Se
  /// guarda y no se deriva de `fecha` al leer: si cambiara con la zona de hoy,
  /// viajar romperia las rachas ya ganadas.
  dia DateTime @default(dbgenerated("((now() AT TIME ZONE 'America/Bogota'::text))::date")) @db.Date

  /// Al eliminar la cuenta se borran sus resultados. Es el RF12: la persona
  /// puede pedir que se elimine todo lo suyo.
  usuario   Usuario   @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  actividad Actividad @relation(fields: [idActividad], references: [id], onDelete: Restrict)

  @@unique([idUsuario, idOperacionCliente])
  /// El historial se consulta por persona y por fecha; de ahi el indice.
  @@index([idUsuario, fecha])
  @@index([idUsuario, dia])
  @@index([idActividad])
  @@map("resultado")
}

model RecursoApoyo {
  id          String  @id @default(uuid()) @map("id_recurso") @db.Uuid
  /// Vacio cuando el recurso aplica siempre, como las lineas de atencion.
  idCategoria String? @map("id_categoria") @db.Uuid
  titulo      String  @db.VarChar(120)
  descripcion String?
  /// Que clase de recurso es: contacto, lectura, ejercicio.
  tipo        String  @db.VarChar(30)
  enlace      String? @db.VarChar(255)

  /// De que trata. Es lo que permite al asistente responder a una intencion
  /// con recursos de la base en lugar de con texto escrito en el codigo.
  ///
  /// Vacio en los recursos que valen para cualquier tema, como las lineas de
  /// atencion.
  tema String? @db.VarChar(30)

  /// Donde sirve este recurso: `nacional`, `bogota`, `universidad`.
  ///
  /// No es un adorno. La Linea 106 es un servicio distrital y se marca desde
  /// Bogota; la sede principal de la universidad esta en Fusagasuga. Dar solo
  /// ese numero a quien esta fuera de Bogota es darle un telefono que no
  /// contesta, y en una situacion de riesgo eso no es un detalle.
  cobertura String? @db.VarChar(30)

  /// El pais donde sirve, como codigo ISO 3166-1 de dos letras (`CO`).
  ///
  /// Se deduce de la zona horaria de la persona, nunca de su ubicacion
  /// (SCRUM-124). Vacio cuando sirve en cualquier parte: las lecturas y el
  /// directorio internacional, que es lo unico que recibe quien esta en un pais
  /// sin lineas verificadas.
  pais String? @db.VarChar(2)

  /// De donde sale el dato: la pagina oficial donde se confirmo. Obligatoria en
  /// los contactos (restriccion `recurso_apoyo_contacto_con_fuente`).
  fuente String? @db.VarChar(255)

  /// El dia en que una persona lo confirmo en esa fuente. Obligatorio en los
  /// contactos, junto a la fuente.
  verificadoEl DateTime? @map("verificado_el") @db.Date

  categoria Categoria? @relation(fields: [idCategoria], references: [id], onDelete: SetNull)

  @@index([idCategoria])
  @@index([tipo, tema])
  @@index([tipo, pais])
  @@map("recurso_apoyo")
}

/// Mi Diario (RF14).
///
/// La tabla se crea ahora aunque el modulo sea del Ciclo 8: adelantarla evita
/// una migracion sobre una base ya en uso. Ver SCRUM-52.
///
/// Su contenido **no se evalua**. Ninguna entrada produce puntaje ni nivel, y
/// por eso no se relaciona con actividad ni con categoria.
model EntradaDiario {
  id        String @id @default(uuid()) @map("id_entrada") @db.Uuid
  idUsuario String @map("id_usuario") @db.Uuid

  /// El dia del calendario de Colombia al que pertenece la anotacion. No
  /// siempre coincide con `fechaCreacion`: se puede anadir a un dia pasado.
  dia DateTime @default(dbgenerated("((now() AT TIME ZONE 'America/Bogota'::text))::date")) @db.Date

  titulo String? @db.VarChar(120)

  /// Con formato `enriquecido`, el documento del editor serializado en JSON.
  /// Nunca HTML. Los diagramas van aparte, en `adjuntos`.
  contenido String

  formato FormatoEntrada @default(texto_plano)

  /// Etiquetas de animo y adjuntos: solo con conexion. Subir un archivo
  /// requiere red por definicion.
  etiquetas Json?
  adjuntos  Json?

  /// Unico por persona, igual que en RESULTADO y por el mismo motivo.
  idOperacionCliente String @map("id_operacion_cliente") @db.Uuid

  /// Aumenta con cada edicion. Permite detectar que dos dispositivos editaron
  /// la misma entrada. La sincronizacion nunca sobrescribe: ante un conflicto
  /// la copia local se guarda aparte. Ver ADR 0009.
  version Int @default(1)

  /// La pone la base al insertar, venga lo que venga: de ella se cuenta la
  /// hora para editar, y no puede elegirla quien escribe. No se puede editar.
  /// Ver la migracion 20261003180000_diario_por_dia.
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  fechaEdicion  DateTime @updatedAt @map("fecha_edicion") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([idUsuario, idOperacionCliente])
  @@index([idUsuario, fechaCreacion])
  @@index([idUsuario, dia])
  @@map("entrada_diario")
}
