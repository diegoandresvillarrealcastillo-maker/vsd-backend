{
  // Revisa los tipos de lo que tsconfig.json deja fuera: los archivos de
  // prueba y los de configuracion.
  //
  // Sin esto nadie comprueba los tipos de `*.spec.ts`. Vitest transpila sin
  // mirarlos y ESLint aplica reglas de estilo, no de tipos, asi que un doble
  // que dejara de implementar su puerto seguiria compilando y pasando: justo
  // el fallo que estas pruebas existen para evitar.
  //
  // `rootDir` en la raiz porque aqui entran archivos que viven fuera de src/.
  // No emite nada, asi que no afecta a lo que se despliega.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // El contenido del catalogo (`src/pruebas/catalogo`) lo genera `node` directamente, sin compilar, y asi
    // importa sus modulos con la extension `.ts` (SCRUM-222). Solo vale sin emitir, y aqui no se emite.
    "allowImportingTsExtensions": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "vitest.config.mts",
    "vitest.integracion.config.mts",
    "prisma.config.ts",
    "scripts/carga/*.ts",
    "scripts/carga/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
