# ============================================================
#  VSD Health - archivos que nunca deben llegar al repositorio
# ============================================================

# ---------- Secretos y entorno ----------
# Regla critica: ningun archivo de entorno real se versiona.
# Solo .env.example, que contiene los nombres de las variables sin valores.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
service-account*.json

# ---------- Dependencias ----------
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# ---------- Artefactos de construccion ----------
# Anclados a la raiz con "/" inicial. Sin el ancla, "out/" tambien ignoraba
# src/domain/ports/out/, que es una carpeta del codigo fuente y no un
# artefacto. El fallo solo salio a la luz cuando el CI trabajo sobre una
# copia limpia del repositorio.
/dist/
/build/
/out/
.vite/
*.tsbuildinfo

# ---------- Pruebas y cobertura ----------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.lighthouseci/

# ---------- Cache de herramientas ----------
.cache/
.eslintcache
.stylelintcache
.turbo/

# ---------- Registros ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editores ----------
.idea/
# Del editor se comparte lo que afecta al proyecto (extensiones
# recomendadas, formato al guardar, configuracion de depuracion) y se ignora
# lo que es personal de cada maquina.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Especifico del backend ----------
# Cliente de Prisma generado: se regenera con "prisma generate".
prisma/generated/
*.sqlite
*.sqlite3
*.db
