{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_comprobar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "El servicio esta operativo."
          }
        },
        "summary": "Comprobar que el servicio responde",
        "tags": [
          "Estado"
        ]
      }
    },
    "/api/resultados": {
      "post": {
        "description": "La operacion es idempotente. Reenviar la misma peticion con el mismo clientOperationId devuelve el resultado ya registrado en lugar de crear otro, de modo que un reintento tras una caida de red es seguro.",
        "operationId": "ActivityResultController_registrar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarResultadoDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resultado registrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoRespuestaDto"
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo de la peticion no es valido o incumple una regla del dominio."
          },
          "401": {
            "description": "Falta la sesion o el token no es valido."
          },
          "404": {
            "description": "La operacion solicitada no esta disponible. Se responde asi tanto si no existe como si pertenece a otra persona, para no revelar cual de las dos cosas ocurre."
          },
          "429": {
            "description": "Demasiadas peticiones."
          }
        },
        "security": [
          {
            "sesion": []
          }
        ],
        "summary": "Registrar el resultado de una actividad",
        "tags": [
          "Resultados"
        ]
      }
    },
    "/api/catalogo": {
      "get": {
        "description": "Las categorias con sus actividades disponibles. No incluye el puntaje maximo ni los cortes de nivel: eso sirve para interpretar un resultado, y esa interpretacion ocurre en el servidor.",
        "operationId": "CatalogoController_consultar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Categorias con sus actividades.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoriaDelCatalogoDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Consultar el catalogo de actividades",
        "tags": [
          "Catalogo"
        ]
      }
    },
    "/api/asistente": {
      "post": {
        "description": "VSD IA en su primera version: reglas, sin modelo de lenguaje. Si el texto contiene una expresion de riesgo, la respuesta incluye siempre lineas de atencion, y esa decision no depende de que se reconozca la pregunta. El asistente no diagnostica ni opina sobre la salud de nadie.",
        "operationId": "AsistenteController_preguntar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultarAsistenteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta del asistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsistenteRespuestaDto"
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo de la peticion no es valido."
          },
          "401": {
            "description": "Falta la sesion o el token no es valido."
          },
          "429": {
            "description": "Demasiadas peticiones."
          }
        },
        "security": [
          {
            "sesion": []
          }
        ],
        "summary": "Preguntar al asistente",
        "tags": [
          "Asistente"
        ]
      }
    }
  },
  "info": {
    "title": "VSD Health API",
    "description": "API de VSD Health, herramienta de acompanamiento del bienestar emocional y cognitivo.\n\nVSD Health no diagnostica, no formula medicamentos y no reemplaza la atencion de psicologos, medicos ni psiquiatras. Los resultados que devuelve esta API son orientativos.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Resultados",
      "description": "Registro de resultados de actividades"
    },
    {
      "name": "Catalogo",
      "description": "Categorias y actividades disponibles"
    },
    {
      "name": "Asistente",
      "description": "VSD IA"
    },
    {
      "name": "Estado",
      "description": "Comprobacion de vida del servicio"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "sesion": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Token de acceso de Supabase. El navegador lo obtiene al iniciar sesion y lo envia en la cabecera Authorization."
      }
    },
    "schemas": {
      "RegistrarResultadoDto": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "string",
            "description": "Identificador de la actividad realizada.",
            "format": "uuid",
            "example": "33333333-3333-4333-a333-333333333333"
          },
          "clientOperationId": {
            "type": "string",
            "description": "Identificador de la operacion, generado por el dispositivo. Reenviar el mismo valor en un reintento evita que se duplique el resultado.",
            "format": "uuid",
            "example": "44444444-4444-4444-b444-444444444444"
          },
          "score": {
            "type": "number",
            "description": "Puntaje crudo obtenido, en la escala de la actividad. Se omite en las actividades de registro, como una bitacora de sueno, que producen datos y no una calificacion. El maximo lo declara la actividad, no esta peticion.",
            "example": 8,
            "minimum": 0
          },
          "metadata": {
            "type": "object",
            "description": "Informacion propia del tipo de actividad: las horas de una bitacora de sueno, las respuestas de un registro emocional. No puede traer claves que ya sean campos propios.",
            "example": {
              "horasDormidas": 6.5,
              "despertares": 2
            }
          },
          "completedAt": {
            "type": "string",
            "description": "Momento en que se completo la actividad. No puede estar en el futuro.",
            "format": "date-time",
            "example": "2026-09-14T11:00:00.000Z"
          }
        },
        "required": [
          "activityId",
          "clientOperationId",
          "completedAt"
        ]
      },
      "ResultadoRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "activityId": {
            "type": "string",
            "format": "uuid"
          },
          "nivelOrientativo": {
            "type": "string",
            "description": "Nivel orientativo del resultado. Es una orientacion sobre como fue la actividad, nunca un diagnostico. Ausente en las actividades de registro, que no producen puntaje.",
            "enum": [
              "favorable",
              "en_seguimiento",
              "requiere_atencion"
            ]
          },
          "sugiereAcompanamiento": {
            "type": "boolean",
            "description": "Indica si conviene mostrar recursos de apoyo profesional junto al resultado."
          },
          "metadata": {
            "type": "object",
            "description": "Informacion propia del tipo de actividad, tal como la envio el dispositivo. En una actividad de registro es todo su contenido."
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "activityId",
          "sugiereAcompanamiento",
          "completedAt"
        ]
      },
      "ActividadDelCatalogoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "example": "Parejas de cartas"
          },
          "tipo": {
            "type": "string",
            "example": "juego",
            "description": "Como se realiza: juego, preguntas o bitacora."
          },
          "descripcion": {
            "type": "string",
            "example": "Encuentra las parejas iguales en el menor numero de intentos."
          },
          "produceNivel": {
            "type": "boolean",
            "example": true,
            "description": "Si al terminar hay un nivel orientativo que mostrar. Las bitacoras no lo tienen: registran, no califican."
          }
        },
        "required": [
          "id",
          "nombre",
          "produceNivel"
        ]
      },
      "CategoriaDelCatalogoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "example": "Cognicion"
          },
          "descripcion": {
            "type": "string"
          },
          "actividades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActividadDelCatalogoDto"
            }
          }
        },
        "required": [
          "id",
          "nombre",
          "actividades"
        ]
      },
      "ConsultarAsistenteDto": {
        "type": "object",
        "properties": {
          "texto": {
            "type": "string",
            "description": "Lo que escribio la persona, tal cual. No se guarda: se usa para responder y se descarta.",
            "example": "como puedo dormir mejor",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "texto"
        ]
      },
      "RecursoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "type": "string",
            "example": "Linea 192, opcion 4"
          },
          "descripcion": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "example": "contacto",
            "enum": [
              "contacto",
              "lectura",
              "ejercicio"
            ]
          },
          "cobertura": {
            "type": "string",
            "description": "Donde sirve el recurso. La interfaz deberia mostrarlo: un telefono que solo atiende en una ciudad no ayuda a quien esta fuera de ella.",
            "example": "nacional"
          },
          "enlace": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "titulo",
          "tipo"
        ]
      },
      "AsistenteRespuestaDto": {
        "type": "object",
        "properties": {
          "intencion": {
            "type": "string",
            "description": "Que se entendio de la pregunta.",
            "example": "como_duermo_mejor"
          },
          "mensaje": {
            "type": "string",
            "example": "Descansar mejor casi siempre empieza por la rutina."
          },
          "recursos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecursoDto"
            }
          },
          "senalDeRiesgo": {
            "type": "boolean",
            "description": "Cierto cuando el texto contenia una expresion de riesgo. La interfaz deberia destacar esta respuesta."
          },
          "incluyeLineasDeAtencion": {
            "type": "boolean",
            "description": "Cierto cuando la respuesta trae al menos un contacto. Si senalDeRiesgo es cierto, este tambien lo es, siempre."
          }
        },
        "required": [
          "intencion",
          "mensaje",
          "recursos",
          "senalDeRiesgo",
          "incluyeLineasDeAtencion"
        ]
      }
    }
  }
}
